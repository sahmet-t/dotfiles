/* Matugen tarafından otomatik üretildi */
* {
    bg: {{ colors.background.default.hex }}e6;
    bg-alt: {{ colors.surface_container.default.hex }}ff;
    surface: {{ colors.surface_container_high.default.hex }}ff;
    fg: {{ colors.on_surface.default.hex }}ff;
    fg-muted: {{ colors.on_surface_variant.default.hex }}ff;
    accent: {{ colors.primary.default.hex }}ff;
    urgent: {{ colors.error.default.hex }}ff;
}
