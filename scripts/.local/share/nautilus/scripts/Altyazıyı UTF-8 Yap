#!/usr/bin/env bash
# Nautilus sağ tık menüsü: Seçili altyazı dosyalarını/klasörlerini BOM'suz UTF-8 yapıp
# Stremio uyumlu saf ASCII yol/ad ile ~/Altyazilar klasörüne hazırlar.
set -euo pipefail

FILES=()
if [[ -n "${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}" ]]; then
    while IFS= read -r path; do
        [[ -n "$path" ]] && FILES+=("$path")
    done <<< "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
elif [[ $# -gt 0 ]]; then
    FILES=("$@")
fi

[[ ${#FILES[@]} -gt 0 ]] || exit 0

exec "$HOME/.local/bin/srt-utf8" --stremio --notify "${FILES[@]}"
