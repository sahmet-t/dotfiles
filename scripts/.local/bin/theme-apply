#!/usr/bin/env bash
# ==============================================================================
# theme-apply — Hibrit Tema Motoru (Küratörlü Paletler + Matugen Dinamik Renkler)
# Kullanım:
#   theme-apply --preset <tema_klasor_adi>
#   theme-apply --wallpaper <gorsel_yolu>
# ==============================================================================
set -euo pipefail

THEMES_DIR="$HOME/.local/share/my-themes"
STATE_DIR="$HOME/.local/state/my-theme"
mkdir -p "$STATE_DIR"

strip_hash() {
    echo "${1#\#}"
}

write_clean() {
    local target="$1"
    mkdir -p "$(dirname "$target")"
    if [[ -L "$target" && ! -e "$target" ]]; then
        rm -f "$target"
    fi
    cat > "$target"
}

apply_folder_icons() {
    local accent_hex="${1:-}"
    local src_dir="/usr/share/icons/Adwaita/scalable/places"
    local theme_root="$HOME/.local/share/icons/MyTheme-Adwaita"
    local dst_dir="$theme_root/scalable/places"

    [[ -d "$src_dir" ]] || return 0
    [[ "$accent_hex" =~ ^#?[0-9a-fA-F]{6}$ ]] || return 0
    command -v python3 >/dev/null 2>&1 || return 0

    mkdir -p "$dst_dir"

    cat > "$theme_root/index.theme" <<'EOF'
[Icon Theme]
Name=MyTheme-Adwaita
Comment=Aktif temayla otomatik renklendirilen Adwaita klasör ikonları
Inherits=Adwaita,hicolor
Directories=scalable/places

[scalable/places]
Context=Places
Size=128
MinSize=16
MaxSize=512
Type=Scalable
EOF

    python3 - "$accent_hex" "$src_dir" "$dst_dir" <<'PY'
import colorsys, glob, os, sys

hex_in = sys.argv[1].lstrip("#")
src_dir, dst_dir = sys.argv[2], sys.argv[3]

r = int(hex_in[0:2], 16) / 255.0
g = int(hex_in[2:4], 16) / 255.0
b = int(hex_in[4:6], 16) / 255.0
h, l, s = colorsys.rgb_to_hls(r, g, b)

# Klasör yüzeyi ne aşırı parlak ne fazla karanlık olsun; siyah-beyaz temada gri kalsın
body_l = max(0.50, min(0.70, l))
body_s = min(s, 0.72)

def to_hex(hv, lv, sv):
    rr, gg, bb = colorsys.hls_to_rgb(hv, max(0.0, min(1.0, lv)), max(0.0, min(1.0, sv)))
    return "#{:02x}{:02x}{:02x}".format(round(rr * 255), round(gg * 255), round(bb * 255))

mapping = {
    "#438de6": to_hex(h, body_l * 0.58, min(1.0, body_s * 1.05)),  # arka sekme & klasör simgesi
    "#62a0ea": to_hex(h, body_l * 0.78, min(1.0, body_s * 1.05)),  # alt kenar gölgesi
    "#a4caee": to_hex(h, body_l,        body_s),                   # ana ön gövde
    "#afd4ff": to_hex(h, min(0.88, body_l * 1.15), body_s * 0.90), # sol üst parlama
    "#c0d5ea": to_hex(h, min(0.90, body_l * 1.18), body_s * 0.65), # sağ kenar yansıma
}

targets = (
    glob.glob(os.path.join(src_dir, "folder*.svg"))
    + [os.path.join(src_dir, n) for n in ("user-bookmarks.svg", "user-desktop.svg", "user-home.svg")]
)

for src in targets:
    if not os.path.isfile(src):
        continue
    with open(src, "r", encoding="utf-8") as f:
        svg = f.read()
    for old, new in mapping.items():
        svg = svg.replace(old, new)
    with open(os.path.join(dst_dir, os.path.basename(src)), "w", encoding="utf-8") as f:
        f.write(svg)

inode_link = os.path.join(dst_dir, "inode-directory.svg")
if os.path.lexists(inode_link):
    os.remove(inode_link)
os.symlink("folder.svg", inode_link)
PY

    if command -v gtk4-update-icon-cache >/dev/null 2>&1; then
        gtk4-update-icon-cache -f -t -q "$theme_root" >/dev/null 2>&1 || true
    elif command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t -q "$theme_root" >/dev/null 2>&1 || true
    fi

    if command -v gsettings >/dev/null 2>&1; then
        # Açık GTK4/Nautilus pencerelerinin klasör rengini anında yenilemesi için ikon temasını tetikle
        gsettings set org.gnome.desktop.interface icon-theme 'Adwaita' >/dev/null 2>&1 || true
        gsettings set org.gnome.desktop.interface icon-theme 'MyTheme-Adwaita' >/dev/null 2>&1 || true
    fi
}

reload_apps() {
    hyprctl reload >/dev/null 2>&1 || true
    pkill -SIGUSR2 waybar >/dev/null 2>&1 || true
    swaync-client -rs >/dev/null 2>&1 || true
    pkill -SIGUSR2 ghostty >/dev/null 2>&1 || true
    # Nautilus penceresiz arka plan servisi olarak kalmışsa yeni CSS'i alması için temizle
    if pgrep -x nautilus >/dev/null 2>&1; then
        if ! hyprctl clients 2>/dev/null | grep -qi "org\.gnome\.Nautilus"; then
            nautilus -q >/dev/null 2>&1 || true
        fi
    fi
}

apply_preset() {
    local name="$1"
    local theme_dir="$THEMES_DIR/$name"
    local palette="$theme_dir/palette.env"

    if [[ ! -f "$palette" ]]; then
        notify-send "Tema Motoru" "Palet bulunamadı: $name" -u critical || true
        exit 1
    fi

    # shellcheck disable=SC1090
    source "$palette"

    local bg_s bg_alt_s surf_s fg_s fg_m_s acc_s acc_alt_s urg_s brd_s
    bg_s=$(strip_hash "$BG")
    bg_alt_s=$(strip_hash "$BG_ALT")
    surf_s=$(strip_hash "$SURFACE")
    fg_s=$(strip_hash "$FG")
    fg_m_s=$(strip_hash "$FG_MUTED")
    acc_s=$(strip_hash "$ACCENT")
    acc_alt_s=$(strip_hash "$ACCENT_ALT")
    urg_s=$(strip_hash "$URGENT")
    brd_s=$(strip_hash "$BORDER_INACTIVE")

    # 1a. Hyprland (0.57+ Lua)
    write_clean "$HOME/.config/hypr/colors.lua" <<EOF
-- Tema: ${THEME_NAME}
return {
    bg = "rgb(${bg_s})",
    bg_alt = "rgb(${bg_alt_s})",
    surface = "rgb(${surf_s})",
    fg = "rgb(${fg_s})",
    fg_muted = "rgb(${fg_m_s})",
    accent = "rgb(${acc_s})",
    accent_alt = "rgb(${acc_alt_s})",
    urgent = "rgb(${urg_s})",
    border_inactive = "rgba(${brd_s}aa)",
}
EOF

    # 1b. Hyprlock (Hyprlang .conf)
    write_clean "$HOME/.config/hypr/colors.conf" <<EOF
# Tema: ${THEME_NAME}
\$bg = rgb(${bg_s})
\$bg_alt = rgb(${bg_alt_s})
\$surface = rgb(${surf_s})
\$fg = rgb(${fg_s})
\$fg_muted = rgb(${fg_m_s})
\$accent = rgb(${acc_s})
\$accent_alt = rgb(${acc_alt_s})
\$urgent = rgb(${urg_s})
\$border_inactive = rgba(${brd_s}aa)
EOF

    # 2. Waybar
    write_clean "$HOME/.config/waybar/colors.css" <<EOF
/* Tema: ${THEME_NAME} */
@define-color bg ${BG};
@define-color bg_alt ${BG_ALT};
@define-color surface ${SURFACE};
@define-color fg ${FG};
@define-color fg_muted ${FG_MUTED};
@define-color accent ${ACCENT};
@define-color accent_alt ${ACCENT_ALT};
@define-color urgent ${URGENT};
EOF

    # 3. Rofi
    write_clean "$HOME/.config/rofi/colors.rasi" <<EOF
/* Tema: ${THEME_NAME} */
* {
    bg: ${BG}e6;
    bg-alt: ${BG_ALT}ff;
    surface: ${SURFACE}ff;
    fg: ${FG}ff;
    fg-muted: ${FG_MUTED}ff;
    accent: ${ACCENT}ff;
    urgent: ${URGENT}ff;
}
EOF

    # 4. SwayNC
    write_clean "$HOME/.config/swaync/colors.css" <<EOF
/* Tema: ${THEME_NAME} */
@define-color bg ${BG};
@define-color bg_alt ${BG_ALT};
@define-color surface ${SURFACE};
@define-color fg ${FG};
@define-color fg_muted ${FG_MUTED};
@define-color accent ${ACCENT};
@define-color urgent ${URGENT};
EOF

    # 5. Ghostty
    write_clean "$HOME/.config/ghostty/theme" <<EOF
# Tema: ${THEME_NAME}
background = ${BG}
foreground = ${FG}
cursor-color = ${ACCENT}
selection-background = ${SURFACE}
selection-foreground = ${FG}
palette = 0=${TERM_0}
palette = 1=${TERM_1}
palette = 2=${TERM_2}
palette = 3=${TERM_3}
palette = 4=${TERM_4}
palette = 5=${TERM_5}
palette = 6=${TERM_6}
palette = 7=${TERM_7}
palette = 8=${TERM_8}
palette = 9=${TERM_1}
palette = 10=${TERM_2}
palette = 11=${TERM_3}
palette = 12=${TERM_4}
palette = 13=${TERM_5}
palette = 14=${TERM_6}
palette = 15=${TERM_15}
EOF

    # 6. GTK3 & GTK4 / Libadwaita 1.6–1.10+ (Nautilus, pwvucontrol, Overskride)
    local gtk3_css gtk4_css
    gtk3_css=$(cat <<EOF
/* Tema: ${THEME_NAME} */
@define-color accent_color ${ACCENT};
@define-color accent_bg_color ${ACCENT};
@define-color accent_fg_color ${ACCENT_FG};
@define-color window_bg_color ${BG};
@define-color window_fg_color ${FG};
@define-color view_bg_color ${BG_ALT};
@define-color view_fg_color ${FG};
@define-color headerbar_bg_color ${BG};
@define-color headerbar_fg_color ${FG};
@define-color headerbar_backdrop_color ${BG};
@define-color card_bg_color ${BG_ALT};
@define-color card_fg_color ${FG};
@define-color popover_bg_color ${BG_ALT};
@define-color popover_fg_color ${FG};
@define-color dialog_bg_color ${BG};
@define-color dialog_fg_color ${FG};
@define-color sidebar_bg_color ${SIDEBAR};
@define-color sidebar_fg_color ${FG};
@define-color sidebar_backdrop_color ${SIDEBAR};
EOF
)
    gtk4_css=$(cat <<EOF
${gtk3_css}

:root {
    --accent-color: ${ACCENT};
    --accent-bg-color: ${ACCENT};
    --accent-fg-color: ${ACCENT_FG};
    --window-bg-color: ${BG};
    --window-fg-color: ${FG};
    --view-bg-color: ${BG_ALT};
    --view-fg-color: ${FG};
    --headerbar-bg-color: ${BG};
    --headerbar-fg-color: ${FG};
    --headerbar-backdrop-color: ${BG};
    --card-bg-color: ${BG_ALT};
    --card-fg-color: ${FG};
    --popover-bg-color: ${BG_ALT};
    --popover-fg-color: ${FG};
    --dialog-bg-color: ${BG};
    --dialog-fg-color: ${FG};
    --sidebar-bg-color: ${SIDEBAR};
    --sidebar-fg-color: ${FG};
    --sidebar-backdrop-color: ${SIDEBAR};
}
EOF
)
    printf '%s\n' "$gtk3_css" | write_clean "$HOME/.config/gtk-3.0/colors.css"
    printf '%s\n' "$gtk4_css" | write_clean "$HOME/.config/gtk-4.0/colors.css"
    apply_folder_icons "$ACCENT"

    # Tema klasöründe duvar kağıdı varsa uygula
    local wp
    wp=$(find -L "$theme_dir" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | head -n 1 || true)
    if [[ -n "$wp" ]] && command -v awww >/dev/null 2>&1; then
        awww img "$wp" --transition-type grow --transition-duration 0.8 --transition-fps 60 >/dev/null 2>&1 || true
    fi

    echo "preset:$name" > "$STATE_DIR/current"
    reload_apps
    notify-send "Tema Uygulandı" "${THEME_NAME}" || true
}

apply_wallpaper() {
    local img="$1"
    if [[ ! -f "$img" ]]; then
        notify-send "Tema Motoru" "Duvar kağıdı bulunamadı: $img" -u critical || true
        exit 1
    fi

    if command -v awww >/dev/null 2>&1; then
        awww img "$img" --transition-type grow --transition-duration 0.8 --transition-fps 60 >/dev/null 2>&1 || true
    fi

    if command -v matugen >/dev/null 2>&1; then
        matugen image "$img" --type scheme-fidelity --source-color-index 0 -m dark \
            || matugen image "$img" --type scheme-fidelity -m dark
    fi

    local accent_hex=""
    if [[ -f "$HOME/.config/waybar/colors.css" ]]; then
        accent_hex=$(grep -oE '@define-color accent #[0-9a-fA-F]{6}' "$HOME/.config/waybar/colors.css" | awk '{print $3}' | head -n 1 || true)
    fi
    [[ -n "$accent_hex" ]] && apply_folder_icons "$accent_hex"

    echo "wallpaper:$img" > "$STATE_DIR/current"
    reload_apps
    notify-send "Dinamik Tema Uygulandı" "$(basename "$img")" || true
}

case "${1:-}" in
    --preset)
        apply_preset "${2:?Tema adı belirtilmeli}"
        ;;
    --wallpaper)
        apply_wallpaper "${2:?Görsel yolu belirtilmeli}"
        ;;
    *)
        echo "Kullanım: theme-apply --preset <tema> | --wallpaper <yol>"
        exit 1
        ;;
esac
