#!/usr/bin/env bash
# ==============================================================================
# screenshot — XDG uyumlu Bölge (slurp + grim + Satty) ve Tam Ekran Görüntüsü
# Kullanım: screenshot region | full
# ==============================================================================
set -euo pipefail

PICTURES_DIR="$(xdg-user-dir PICTURES 2>/dev/null || true)"
PICTURES_DIR="${PICTURES_DIR:-$HOME/Pictures}"
OUT_DIR="$PICTURES_DIR/Screenshots"
mkdir -p "$OUT_DIR"

case "${1:-}" in
    region)
        geom=$(slurp -d 2>/dev/null) || exit 0
        [[ -n "$geom" ]] || exit 0

        out_file="$OUT_DIR/$(date +'%Y-%m-%d_%H-%M-%S').png"
        grim -g "$geom" "$out_file"
        wl-copy --type image/png < "$out_file"
        notify-send -i "$out_file" "Ekran Görüntüsü Alındı" "Panoya kopyalandı ve kaydedildi" || true

        satty --filename "$out_file" \
              --output-filename "$out_file" \
              --resize smart \
              --copy-command "wl-copy --type image/png" \
              --actions-on-enter save-to-clipboard,save-to-file,exit \
              --actions-on-escape exit \
              --save-after-copy \
              --early-exit all
        ;;
    full)
        out_file="$OUT_DIR/$(date +'%Y-%m-%d_%H-%M-%S').png"
        active_out="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' | head -n1 || true)"
        if [[ -n "$active_out" ]]; then
            grim -o "$active_out" "$out_file"
        else
            grim "$out_file"
        fi
        wl-copy --type image/png < "$out_file"
        notify-send -i "$out_file" "Tam Ekran Görüntüsü Alındı" "Panoya kopyalandı ve kaydedildi" || true

        satty --filename "$out_file" \
              --output-filename "$out_file" \
              --resize smart \
              --copy-command "wl-copy --type image/png" \
              --actions-on-enter save-to-clipboard,save-to-file,exit \
              --actions-on-escape exit \
              --save-after-copy \
              --early-exit all
        ;;
    *)
        echo "Kullanım: screenshot region | full"
        exit 1
        ;;
esac
