#!/usr/bin/env bash
# ==============================================================================
# night-light — Hyprsunset Gece Işığı / Mavi Işık Filtresi Kontrolü (Waybar)
# Kullanım: night-light [status|toggle|off|auto|warmer|cooler]
# ==============================================================================
set -euo pipefail

STATE_DIR="$HOME/.local/state/my-theme"
LOCK_FILE="$STATE_DIR/nightlight.lock"
mkdir -p "$STATE_DIR"

SIGNAL=8
MIN_TEMP=2200
MAX_TEMP=6000
STEP=250

ensure_daemon() {
    if ! command -v hyprsunset >/dev/null 2>&1; then
        return 1
    fi
    if ! pgrep -x hyprsunset >/dev/null 2>&1; then
        nohup hyprsunset >/dev/null 2>&1 &
        sleep 0.35
    fi
}

get_temp() {
    if command -v hyprsunset >/dev/null 2>&1 && pgrep -x hyprsunset >/dev/null 2>&1; then
        local out
        out=$(hyprctl hyprsunset temperature 2>/dev/null || true)
        if [[ "$out" =~ ^[0-9]+$ ]]; then
            echo "$out"
            return 0
        fi
    fi
    echo "$MAX_TEMP"
}

apply_temp() {
    local val="$1"
    ensure_daemon || exit 0
    if (( val >= MAX_TEMP )); then
        # Önce sıcaklığı 6000'e çekip sonra identity=true yap ki sorgu tutarlı kalsın
        hyprctl hyprsunset temperature "$MAX_TEMP" >/dev/null 2>&1 || true
        hyprctl hyprsunset identity true >/dev/null 2>&1 || true
    else
        (( val < MIN_TEMP )) && val=$MIN_TEMP
        # identity=false yapmadan hyprsunset 0.4+ yeni sıcaklığı görsel olarak uygulamaz
        hyprctl hyprsunset identity false >/dev/null 2>&1 || true
        hyprctl hyprsunset temperature "$val" >/dev/null 2>&1 || true
    fi
}

notify_waybar() {
    pkill -RTMIN+"$SIGNAL" waybar >/dev/null 2>&1 || true
}

cmd="${1:-status}"

if [[ "$cmd" == "status" ]]; then
    if ! command -v hyprsunset >/dev/null 2>&1; then
        printf '{"text":"󰖨","tooltip":"Gece Işığı (hyprsunset kurulmadı)","class":"off"}\n'
        exit 0
    fi
    temp=$(get_temp)
    if (( temp >= MAX_TEMP )); then
        printf '{"text":"󰖨","tooltip":"Gece Işığı: Kapalı (Doğal)\\nSol tık: Sıcak mod değiştir\\nScroll: ±250K · Orta tık: Otomatik takvim","class":"off"}\n'
    elif (( temp >= 4000 )); then
        printf '{"text":"󰖔","tooltip":"Gece Işığı: %sK (Akşam)\\nSol tık: Daha sıcak · Sağ tık: Kapat\\nScroll: ±250K · Orta tık: Otomatik takvim","class":"warm"}\n' "$temp"
    else
        printf '{"text":"󰖔","tooltip":"Gece Işığı: %sK (Gece)\\nSol tık: Mod değiştir · Sağ tık: Kapat\\nScroll: ±250K · Orta tık: Otomatik takvim","class":"night"}\n' "$temp"
    fi
    exit 0
fi

# Art arda hızlı tıklamalarda yarış durumunu (race condition) önle
exec 9>"$LOCK_FILE"
flock -w 2 9 || exit 0

case "$cmd" in
    toggle)
        temp=$(get_temp)
        if (( temp >= MAX_TEMP )); then
            apply_temp 4500
        elif (( temp >= 4000 )); then
            apply_temp 3400
        elif (( temp >= 3000 )); then
            apply_temp 2700
        else
            apply_temp "$MAX_TEMP"
        fi
        ;;
    off)
        apply_temp "$MAX_TEMP"
        ;;
    auto)
        ensure_daemon || exit 0
        hyprctl hyprsunset reset >/dev/null 2>&1 || true
        notify-send "Gece Işığı" "Otomatik zaman takvimine dönüldü (19:30 / 21:30)" || true
        ;;
    warmer)
        temp=$(get_temp)
        apply_temp $(( temp - STEP ))
        ;;
    cooler)
        temp=$(get_temp)
        apply_temp $(( temp + STEP ))
        ;;
    *)
        echo "Kullanım: night-light [status|toggle|off|auto|warmer|cooler]"
        exit 1
        ;;
esac

flock -u 9
notify_waybar
