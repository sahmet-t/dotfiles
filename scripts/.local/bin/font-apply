#!/usr/bin/env bash
# ==============================================================================
# font-apply — Tek Tıkla Sistem (GTK), Bar, Menü ve Terminal Font Değiştirici
# Kullanım:
#   font-apply "<UI Font>" "<Mono Font>"
#   font-apply --ui "<UI Font>"
#   font-apply --mono "<Mono Font>"
# ==============================================================================
set -euo pipefail

STATE_DIR="$HOME/.local/state/my-theme"
STATE_FILE="$STATE_DIR/fonts.env"
mkdir -p "$STATE_DIR"

UI_FONT="Inter"
MONO_FONT="JetBrainsMono Nerd Font"

if [[ -f "$STATE_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$STATE_FILE"
fi

case "${1:-}" in
    --ui)
        UI_FONT="${2:?Arayüz fontu belirtilmeli}"
        ;;
    --mono)
        MONO_FONT="${2:?Terminal/kod fontu belirtilmeli}"
        ;;
    "")
        ;;
    *)
        UI_FONT="${1:-$UI_FONT}"
        MONO_FONT="${2:-$MONO_FONT}"
        ;;
esac

cat > "$STATE_FILE" <<EOF
UI_FONT="${UI_FONT}"
MONO_FONT="${MONO_FONT}"
EOF

write_clean() {
    local target="$1"
    mkdir -p "$(dirname "$target")"
    if [[ -L "$target" && ! -e "$target" ]]; then
        rm -f "$target"
    fi
    cat > "$target"
}

# Waybar
write_clean "$HOME/.config/waybar/font.css" <<EOF
* {
    font-family: "${UI_FONT}", "${MONO_FONT}", sans-serif;
    font-size: 13px;
    font-weight: 500;
}
EOF

# SwayNC
write_clean "$HOME/.config/swaync/font.css" <<EOF
* {
    font-family: "${UI_FONT}", sans-serif;
    font-size: 13px;
}
EOF

# Rofi
write_clean "$HOME/.config/rofi/font.rasi" <<EOF
* {
    font: "${UI_FONT} 12";
}
EOF

# Ghostty Terminal
write_clean "$HOME/.config/ghostty/font" <<EOF
font-family = ${MONO_FONT}
font-size = 11.5
EOF

# GTK / GNOME Arayüz Fontu
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface font-name "${UI_FONT} 10.5" >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface monospace-font-name "${MONO_FONT} 10.5" >/dev/null 2>&1 || true
fi

if [[ -x "$HOME/.local/bin/sddm-theme-sync" ]]; then
    "$HOME/.local/bin/sddm-theme-sync" || true
fi

pkill -SIGUSR2 waybar >/dev/null 2>&1 || true
swaync-client -rs >/dev/null 2>&1 || true
pkill -SIGUSR2 ghostty >/dev/null 2>&1 || true

notify-send "Font Güncellendi" "Arayüz: ${UI_FONT}\nTerminal: ${MONO_FONT}" || true
