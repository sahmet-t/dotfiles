{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "custom/nightlight",
        "custom/theme",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery",
        "custom/notification",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 5
        },
        "format-icons": {
            "active": "●",
            "default": "○",
            "empty": "·"
        }
    },

    "clock": {
        "locale": "tr_TR.UTF-8",
        "format": "{:%H:%M  ·  %d %b %a}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    },

    "custom/nightlight": {
        "return-type": "json",
        "exec": "~/.local/bin/night-light status",
        "interval": 60,
        "signal": 8,
        "on-click": "~/.local/bin/night-light toggle",
        "on-click-right": "~/.local/bin/night-light off",
        "on-click-middle": "~/.local/bin/night-light auto",
        "on-scroll-up": "~/.local/bin/night-light cooler",
        "on-scroll-down": "~/.local/bin/night-light warmer"
    },

    "custom/theme": {
        "format": "󰏘",
        "tooltip-format": "Tema, Duvar Kağıdı & Font (Super+Shift+T)",
        "on-click": "~/.local/bin/theme-menu"
    },

    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  Kablolu",
        "format-disconnected": "󰤭  Bağlı değil",
        "max-length": 18,
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {num_connections}",
        "format-off": "󰂲",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "overskride"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Sessiz",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pwvucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "battery": {
        "states": {
            "warning": 25,
            "critical": 12
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"]
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "command -v swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Güç Menüsü (Super+Shift+Esc)",
        "on-click": "~/.local/bin/power-menu"
    }
}
